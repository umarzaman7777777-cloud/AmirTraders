<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed for fingerprint quick-unlock (@capgo/capacitor-native-biometric) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- FIX (2026-08-21): root cause of receipts/exports saving fine on a
         newer phone (Android 11+, where an app's own Documents folder needs
         no permission at all) but silently failing on an older device like
         a 2016-era tablet on Android 10 or below — that older tier still
         REQUIRES these two declared, or @capacitor/filesystem has no legal
         way to ask for the storage access Directory.Documents writes need.
         maxSdkVersion=32 means devices on Android 13+ (which deprecated
         these in favor of scoped storage / media permissions) never even
         see them requested — this only matters for, and only affects,
         older devices. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
</manifest>
