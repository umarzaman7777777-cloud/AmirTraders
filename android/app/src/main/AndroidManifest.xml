<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push notifications (@capacitor/push-notifications, added 2026-08-26):
         required on Android 13+ (API 33+, and this app targets API 36) for the
         runtime permission prompt to even appear - without this declared here,
         PushNotifications.requestPermissions() silently does nothing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed for fingerprint quick-unlock (@capgo/capacitor-native-biometric) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- ADD (2026-08-29, voice commands): required by both voice paths —
         the OFFLINE on-device recognizer (@capacitor-community/speech-
         recognition, which requests/checks this at runtime itself) and
         the ONLINE Google Cloud Speech-to-Text path (index.html records
         via getUserMedia, which needs this same OS-level grant on
         Android before the WebView's own permission prompt can appear). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- FIX (2026-08-23, Galaxy Tab A / Android 8 report): exported files
         (PDF/JPG/CSV), receipt photos, and backups all write through the
         @capacitor/filesystem plugin to Directory.Documents (shared/public
         storage). On classic Android (API <= 28 / Android 9 and below,
         which includes this Android 8 tablet) writing to shared storage
         requires WRITE_EXTERNAL_STORAGE to be BOTH declared here AND
         granted at runtime - the plugin already requests it at runtime
         automatically, but Android silently refuses to even show that
         request for a permission the manifest never declared, so every
         write was failing before the user ever saw a prompt. maxSdkVersion
         caps these to the old permission model only: API 29-32 use scoped
         storage (no broad grant needed for the plugin's own writes) and API
         33+ has no such permission at all, so declaring it unbounded would
         be a no-op there anyway. READ is included because the plugin
         checks/requests both together as one group. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
</manifest>
